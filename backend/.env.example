# Copy this file to .env and fill in real values. Never commit the real .env file.

FLASK_ENV=development
FLASK_DEBUG=true
PORT=5000
SECRET_KEY=change-this-to-a-long-random-string

# Comma-separated list of allowed origins, or * for any (dev only)
CORS_ORIGINS=http://localhost:5173

# --- Email (SMTP) configuration ---
# Enquiries are sent by email only — there is no database.
#
# Example for Gmail:
#   MAIL_SERVER=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=your-gmail-address@gmail.com
#   MAIL_PASSWORD=your-16-character-app-password   (NOT your normal Gmail password —
#                                                    generate an "App Password" from
#                                                    your Google Account security settings)
#   MAIL_RECEIVER=hello@vishesha.events
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_RECEIVER=
